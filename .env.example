# ─── Firebase ───────────────────────────────────────────────
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# ─── Upload Access Code (base64) ────────────────────────────
ACCESS_CODE_B64=base64_encoded_access_code

# ─── OneSignal ──────────────────────────────────────────────
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# ─── Notify Shared Secret ───────────────────────────────────
NOTIFY_SECRET=your_shared_secret

# ─── Vercel ─────────────────────────────────────────────────
VERCEL_NOTIFY_URL=https://your-project.vercel.app/api/notify
